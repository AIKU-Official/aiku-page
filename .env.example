# Copy to .env.local and fill in. Never commit real values.

# Supabase (local: values printed by `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — grants full DB/Storage access. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Shared admin account for /login
ADMIN_ID=
# At least 12 characters in production
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Keys the stored digests of member student IDs (sign-up verification).
# Generate with: openssl rand -base64 48. Changing it invalidates every digest.
MEMBER_VERIFICATION_SECRET=

# Absolute site URL used for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Optional, development only: other hostnames the dev server is opened from
# (e.g. this machine's Tailscale address, to preview on a phone). Comma-separated,
# without scheme or port. Point NEXT_PUBLIC_SUPABASE_URL at the same address so
# the phone can load images and sign in.
DEV_ALLOWED_ORIGINS=
